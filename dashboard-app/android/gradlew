#!/bin/sh
set -e
APP_HOME="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v gradle >/dev/null 2>&1; then
    gradle -p "$APP_HOME" wrapper --gradle-version 8.11.1 --no-daemon
  else
    echo "gradle-wrapper.jar not found and system gradle unavailable" >&2
    exit 1
  fi
fi

exec java -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
