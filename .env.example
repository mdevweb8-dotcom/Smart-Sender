# ==============================================================================
# Smart-Sender Server Configuration
# Author: Mohammed Asim
# ==============================================================================

# Server Port (AI Studio and Docker default: 3000)
PORT=3000
NODE_ENV=development

# APP_URL: Automatically injected in cloud environments
APP_URL="http://localhost:3000"

# ==============================================================================
# Gemini AI (Server-Side Only - Never expose to browser or APK)
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_TIMEOUT_MS=25000

# ==============================================================================
# WhatsApp Linked Device Configuration (whatsapp-web.js only)
# ==============================================================================
# Real WhatsApp phone number linked via QR (without +, e.g., 2499XXXXXXXX)
WHATSAPP_BOT_PHONE=""
# Set to "false" only if you want to start WhatsApp Web manually from the dashboard
WHATSAPP_AUTO_CONNECT="true"
# Persistent LocalAuth directory (must be mounted on a Docker volume in production)
WHATSAPP_SESSION_PATH="./data/wwebjs_auth"
# Optional explicit Chromium executable path (e.g. /usr/bin/chromium in Docker)
PUPPETEER_EXECUTABLE_PATH=""

# Owner WhatsApp number in international format (e.g., +249912345678)
OWNER_PHONE="+249900000000"
OWNER_NAME="Mohammed Asim"

# ==============================================================================
# Timezone & Scheduler
# ==============================================================================
TIMEZONE="Africa/Khartoum"
SCHEDULER_POLL_MS=15000

# ==============================================================================
# Storage & SQLite Database
# ==============================================================================
DATABASE_PATH="./data/smart-sender.sqlite"
STORAGE_PATH="./data/storage"
BACKUP_PATH="./data/backups"
LOG_PATH="./data/logs"
MAX_FILE_SIZE_MB=25

# ==============================================================================
# Dashboard & APK Security (JWT + CORS)
# ==============================================================================
# Change these immediately in production!
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY"
DASHBOARD_ADMIN_USER="admin"
DASHBOARD_ADMIN_PASS="SmartSender@2026"
# Comma-separated allowed origins for CORS (Capacitor APK origins included by default)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,capacitor://localhost,http://localhost"
